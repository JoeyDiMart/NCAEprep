#!/bin/bash

MAIN_FILE="/etc/myapp/config.conf"
BACKUP_FILE="/etc/myapp/config.conf.bak"

# Check both files exist
if [ ! -f "$MAIN_FILE" ]; then
    echo "ERROR: Main config not found: $MAIN_FILE"
    exit 1
fi

if [ ! -f "$BACKUP_FILE" ]; then
    echo "ERROR: Backup file not found: $BACKUP_FILE"
    exit 1
fi

# Compare checksums
MAIN_HASH=$(sha256sum "$MAIN_FILE" | awk '{print $1}')
BACKUP_HASH=$(sha256sum "$BACKUP_FILE" | awk '{print $1}')

if [ "$MAIN_HASH" = "$BACKUP_HASH" ]; then
    echo "OK: Files match. No action taken."
    exit 0
else
    echo "MISMATCH: Files differ. Restoring from backup..."
    rm "$MAIN_FILE"
    cp "$BACKUP_FILE" "$MAIN_FILE"

    # Verify the restore worked
    RESTORED_HASH=$(sha256sum "$MAIN_FILE" | awk '{print $1}')
    if [ "$RESTORED_HASH" = "$BACKUP_HASH" ]; then
        echo "OK: Restore successful."
        exit 0
    else
        echo "ERROR: Restore failed — hashes still don't match!"
        exit 1
    fi
fi